# Set a long random secret before deployment; a local secret is generated otherwise.
SECRET_KEY=
MEALBOY_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
MODEL_PATH=artifacts/food_model.keras
MODEL_LABELS_PATH=artifacts/labels.json
# Extractive answers work offline. Choose ollama for local language generation.
CHAT_PROVIDER=extractive
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
